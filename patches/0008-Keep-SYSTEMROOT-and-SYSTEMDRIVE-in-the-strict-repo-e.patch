 .../devtools/build/lib/runtime/CommandEnvironment.java      | 6 ++++--
 .../devtools/build/lib/runtime/CommonCommandOptions.java    | 5 +++--
 2 files changed, 7 insertions(+), 4 deletions(-)

diff --git a/src/main/java/com/google/devtools/build/lib/runtime/CommandEnvironment.java b/src/main/java/com/google/devtools/build/lib/runtime/CommandEnvironment.java
index bf344b1..d3616d1 100644
--- a/src/main/java/com/google/devtools/build/lib/runtime/CommandEnvironment.java
+++ b/src/main/java/com/google/devtools/build/lib/runtime/CommandEnvironment.java
@@ -104,7 +104,9 @@ import javax.annotation.concurrent.GuardedBy;
  */
 public class CommandEnvironment {
   private static final ImmutableSet<String> ALWAYS_INHERITED_REPO_ENV =
-      OS.getCurrent() == OS.WINDOWS ? ImmutableSet.of("PATH", "PATHEXT") : ImmutableSet.of("PATH");
+      OS.getCurrent() == OS.WINDOWS
+          ? ImmutableSet.of("PATH", "PATHEXT", "SYSTEMDRIVE", "SYSTEMROOT")
+          : ImmutableSet.of("PATH");
 
   private final BlazeRuntime runtime;
   private final BlazeWorkspace workspace;
@@ -1005,7 +1007,7 @@ public class CommandEnvironment {
    * <ul>
    *   <li>the client environment as the base;
    *   <li>if {@code --experimental_strict_repo_env} is set, only the variables {@code PATH} and, on
-   *       Windows only, {@code PATHEXT} are kept;
+   *       Windows only, {@code PATHEXT}, {@code SYSTEMDRIVE} and {@code SYSTEMROOT} are kept;
    *   <li>if {@code --noincompatible_repo_env_ignores_action_env} is set, {@code --action_env} is
    *       applied on top of that;
    *   <li>finally, {@code --repo_env} is applied on top of that.
diff --git a/src/main/java/com/google/devtools/build/lib/runtime/CommonCommandOptions.java b/src/main/java/com/google/devtools/build/lib/runtime/CommonCommandOptions.java
index c8c5b7a..c692b85 100644
--- a/src/main/java/com/google/devtools/build/lib/runtime/CommonCommandOptions.java
+++ b/src/main/java/com/google/devtools/build/lib/runtime/CommonCommandOptions.java
@@ -642,8 +642,9 @@ public class CommonCommandOptions extends OptionsBase {
       metadataTags = {OptionMetadataTag.EXPERIMENTAL},
       help =
           """
-          If true, repository rules and module extensions will only inherit `PATH`, `PATHEXT`
-          (on Windows), and environment variables explicitly specified by `--repo_env`.
+          If true, repository rules and module extensions will only inherit `PATH`, `PATHEXT`,
+          `SYSTEMDRIVE` and `SYSTEMROOT` (the last three on Windows), and environment variables
+          explicitly specified by `--repo_env`.
 
           Note that unless `--incompatible_repo_env_ignores_action_env` is true,
           `--action_env=NAME=VALUE` will also be included.
